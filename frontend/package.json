{
  "name": "frothseg-frontend",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "predev": "node copy-data.mjs",
    "dev": "vite",
    "prebuild": "node copy-data.mjs",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node create-spa-routes.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "gates": "node scripts/gates/frothseg-all-routes.mjs && node scripts/gates/frothseg-content-depth.mjs && node scripts/gates/frothseg-instrument-fit.mjs && node scripts/gates/frothseg-focus-flow.mjs && node scripts/gates/frothseg-instrument-50.mjs"
  },
  "dependencies": {
    "@fasl-work/caos-app-shell": "^0.3.0",
    "@huggingface/transformers": "^4.2.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
