# Minimal-but-complete ignore for an instantiated product repo (ADR-0057).
# This ships WITH the template so every product inherits it from day 1.

# --- Python virtualenvs (ANY name, ANY depth) · NEVER committed; recreate via scripts/setup ---
.venv/
.venv*
**/.venv*
venv/
**/venv/

# --- Python caches / build ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# --- Node / web ---
node_modules/
frontend/dist/
frontend/.vite/
runs/
# build-time overlay generated by frontend/copy-data.mjs (canonical copies live in data/derived + manifests)
frontend/public/data/
frontend/public/manifests/
frontend/public/pyodide/
*.tsbuildinfo
data/derived/.showcase-staging-*/
data/derived/.showcase-previous-*/

# --- Secrets / env (public repo · only .env.example is committed) ---
.env
.env.*
!.env.example

# --- Raw / heavy data · commit ONLY the compact derived artifacts under data/derived/ ---
data/raw/
data/cache/
*.parquet
*.h5
*.hdf5
*.nc
*.mat
*.npy
# large trained models stay local/LFS; commit small ONNX explicitly with `git add -f` if needed
models/*.pt
models/*.pth
models/**/*.pt
models/**/*.pth
# Small canonical release checkpoints are intentionally versioned.
!models/*/checkpoint.pt
!models/*/weights/*.pt
!models/stardist-froth-v1/weights_best.h5
models/unet-watershed-v1/checkpoint.pt
models/*/logs/
models/stardist-froth-v1/weights_last.h5
# Cellpose writes an extensionless ~1.2 GB fine-tuned checkpoint; its SHA-256
# and full lineage are committed in run.json, while the binary remains local.
/models/cellpose-sam-cpsam-v2/weights/
yolo*.pt
*.dll
*.so
*.dylib

# --- OS / logs ---
.DS_Store
Thumbs.db
*.log

# Large per-run SAM dumps stay local; compact acceptance manifests are versioned.
/verification/*
!/verification/workbench-contract.json
!/verification/classical-live-parity.json
!/verification/n1-preregistered-ablation.json
!/verification/p1-ensemble-spread.json
!/verification/p2-domain-randomization.json
!/verification/p4-marker-tta-consensus.json
!/verification/phase1-classical-sweeps.json
!/verification/sam3-feasibility.json
!/verification/phase2-data-preregistration.json
!/verification/phase2-working-cache-regeneration.json
!/verification/p5-diagnostics.json
!/verification/p5-a1-offset-head.json
!/verification/p3-conformal-intervals.json
!/verification/reserve-slice-ledger.json
!/verification/visual-qa/
/verification/visual-qa/*
!/verification/visual-qa/manifest.json
